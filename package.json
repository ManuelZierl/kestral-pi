{
  "name": "kestral-pi-worker",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19 <23"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json",
    "schema": "node scripts/validate-app-schema.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "package:digest": "node scripts/package-digest.mjs",
    "reproducibility": "node scripts/check-reproducibility.mjs",
    "test:release-evidence": "node --test test/release-evidence.test.mjs",
    "test": "npm run build && node --test --test-force-exit test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.7",
    "@earendil-works/pi-ai": "0.80.7",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.6",
    "typescript": "~5.6.2"
  },
  "overrides": {
    "@earendil-works/pi-ai": "0.80.7"
  }
}
